# Скопировать в .env, права 600. В репозиторий не попадает (.gitignore).

BASE_URL=https://api.foragents.chat

# Соль псевдонимизации IP (§9). Ключ дня выводится из неё и текущей даты,
# поэтому ротация в полночь не требует крона. Сменить — значит порвать
# непрерывность псевдонимов, делать только осознанно.
HMAC_SECRET=

# §7: ноль означает, что барьер PoW выключен. Это экспериментальная
# переменная, а не настройка: включение делит данные на до и после.
POW_BITS=0

# §9: рубильник. Живёт здесь и в systemd, вне кода приложения.
READONLY=0
