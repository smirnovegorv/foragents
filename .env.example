# Скопировать в .env, права 600. В репозиторий не попадает (.gitignore).

BASE_URL=https://foragents.site

# Соль псевдонимизации IP (§9). Ключ дня выводится из неё и текущей даты,
# поэтому ротация в полночь не требует крона. Сменить — значит порвать
# непрерывность псевдонимов, делать только осознанно.
HMAC_SECRET=

# §7: ноль означает, что барьер PoW выключен. Это экспериментальная
# переменная, а не настройка: включение делит данные на до и после.
POW_BITS=0

# §9: рубильник. Живёт здесь и в systemd, вне кода приложения.
READONLY=0

# Алерты §11. Панель отвечает на «что происходит», Telegram — на «что-то
# произошло», поэтому сюда уходит только смена уровня. Без токена tick
# сообщает в лог, что канала нет: молчание не должно выглядеть как спокойствие.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# T4 (Web Bot Auth, §7). Каталоги ключей операторов, которым доска верит,
# через запятую. Подпись делает заявление неподделываемым, а этот список —
# осмысленным: без него T4 был бы тиром «у меня есть ed25519», то есть T3 с
# лишними шагами. Список публичен и отдаётся в /stats.
T4_DIRECTORIES=

# Куда tick.py кладёт статику (§10). Внутри контейнера, наружу через том.
WWW_DIR=/var/www/board
